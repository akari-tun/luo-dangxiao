<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:luo.dangxiao.cardreader.app.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="luo.dangxiao.cardreader.app.Views.JsCardView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="JS (Water Billing) Card Operations" FontSize="18" FontWeight="Bold"/>
            
            <!-- Query Section -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                    BorderThickness="1" Padding="15" CornerRadius="5">
                <StackPanel Spacing="10">
                    <TextBlock Text="Query JS Card" FontWeight="SemiBold"/>
                    <Button Content="Query" Command="{Binding JsCardViewModel.QueryCommand}"
                            IsEnabled="{Binding IsConnected}" Width="100" HorizontalAlignment="Left"/>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Serial No:"/>
                            <TextBox Text="{Binding JsCardViewModel.QuerySerno, Mode=OneWay}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                            <TextBlock Text="Card No:"/>
                            <TextBox Text="{Binding JsCardViewModel.QueryCardNo, Mode=OneWay}" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Balance:"/>
                            <TextBox Text="{Binding JsCardViewModel.QueryValue, Mode=OneWay}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                            <TextBlock Text="Charge Times:"/>
                            <TextBox Text="{Binding JsCardViewModel.QueryCount, Mode=OneWay}" IsReadOnly="True"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="5">
                            <TextBlock Text="User Type:"/>
                            <TextBox Text="{Binding JsCardViewModel.QueryUserType, Mode=OneWay}" IsReadOnly="True"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Init Section -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                    BorderThickness="1" Padding="15" CornerRadius="5">
                <StackPanel Spacing="10">
                    <TextBlock Text="Initialize JS User Card" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Serial No:"/>
                            <NumericUpDown Value="{Binding JsCardViewModel.Serno}" Minimum="1"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                            <TextBlock Text="Card No:"/>
                            <TextBox Text="{Binding JsCardViewModel.CardNo}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="5">
                            <TextBlock Text="User Type:"/>
                            <NumericUpDown Value="{Binding JsCardViewModel.UserType}" Minimum="1" Maximum="32"/>
                        </StackPanel>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Initial Balance:"/>
                            <NumericUpDown Value="{Binding JsCardViewModel.Balance}" Minimum="0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                            <TextBlock Text="Charge Times:"/>
                            <NumericUpDown Value="{Binding JsCardViewModel.ChargeTimes}" Minimum="0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Init Card" Command="{Binding JsCardViewModel.InitCommand}"
                                IsEnabled="{Binding IsConnected}"/>
                        <Button Content="Init with Balance" Command="{Binding JsCardViewModel.InitWithBalanceCommand}"
                                IsEnabled="{Binding IsConnected}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Write Section -->
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                    BorderThickness="1" Padding="15" CornerRadius="5">
                <StackPanel Spacing="10">
                    <TextBlock Text="Write Balance" FontWeight="SemiBold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Spacing="5">
                            <TextBlock Text="Card Serial:"/>
                            <TextBox Text="{Binding JsCardViewModel.CardSerno}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                            <TextBlock Text="Balance:"/>
                            <NumericUpDown Value="{Binding JsCardViewModel.Balance}" Minimum="0"/>
                        </StackPanel>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Write Balance" Command="{Binding JsCardViewModel.WriteBalanceCommand}"
                                IsEnabled="{Binding IsConnected}"/>
                        <Button Content="Write + Count" Command="{Binding JsCardViewModel.WriteBalanceAddCountCommand}"
                                IsEnabled="{Binding IsConnected}"/>
                        <Button Content="Reset Card" Command="{Binding JsCardViewModel.ResetCommand}"
                                IsEnabled="{Binding IsConnected}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBox Text="{Binding JsCardViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
