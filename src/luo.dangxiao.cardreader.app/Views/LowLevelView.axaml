<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:luo.dangxiao.cardreader.app.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="luo.dangxiao.cardreader.app.Views.LowLevelView"
             x:DataType="vm:MainViewModel">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Sector Read/Write Section -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Spacing="10">
                <TextBlock Text="Sector Read/Write (Blocks 0-3)" FontSize="16" FontWeight="Bold"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="5">
                        <TextBlock Text="Sector (0-15):"/>
                        <NumericUpDown Value="{Binding LowLevelViewModel.Sector}" Minimum="0" Maximum="15"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                        <TextBlock Text="Key Mode (0=A, 4=B):"/>
                        <NumericUpDown Value="{Binding LowLevelViewModel.KeyMode}" Minimum="0" Maximum="7"/>
                    </StackPanel>
                </Grid>
                <StackPanel Spacing="5">
                    <TextBlock Text="Keys (hex, 6 bytes):"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Text="{Binding LowLevelViewModel.KeyAInput}" FontFamily="Consolas,Monospace" Margin="0,0,5,0"/>
                        <TextBox Grid.Column="1" Text="{Binding LowLevelViewModel.KeyBInput}" FontFamily="Consolas,Monospace" Margin="5,0,0,0"/>
                    </Grid>
                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                        <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6">KeyA:</TextBlock>
                        <TextBlock Text="{Binding LowLevelViewModel.KeyAInput}" VerticalAlignment="Center" FontFamily="Consolas,Monospace" FontSize="11"/>
                        <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="10,0,0,0">KeyB:</TextBlock>
                        <TextBlock Text="{Binding LowLevelViewModel.KeyBInput}" VerticalAlignment="Center" FontFamily="Consolas,Monospace" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Spacing="5">
                    <TextBlock Text="Block Data (hex, 16 bytes each):"/>
                    <Grid RowDefinitions="Auto,4,Auto,4,Auto,4,Auto" ColumnDefinitions="Auto,*">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="B0:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LowLevelViewModel.Block0Data}" FontFamily="Consolas,Monospace"/>
                        <Separator Grid.Row="1" Grid.Column="1"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="B1:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LowLevelViewModel.Block1Data}" FontFamily="Consolas,Monospace"/>
                        <Separator Grid.Row="3" Grid.Column="1"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="B2:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LowLevelViewModel.Block2Data}" FontFamily="Consolas,Monospace"/>
                        <Separator Grid.Row="5" Grid.Column="1"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="B3:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LowLevelViewModel.Block3Data}" FontFamily="Consolas,Monospace"/>
                    </Grid>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Read Sector" Command="{Binding LowLevelViewModel.ReadBlockCommand}"
                            IsEnabled="{Binding IsConnected}"/>
                    <Button Content="Write Sector" Command="{Binding LowLevelViewModel.WriteBlockCommand}"
                            IsEnabled="{Binding IsConnected}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Read All Sectors Section -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Spacing="10">
                <TextBlock Text="Read All Sectors (0-15)" FontSize="16" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <Button Content="Read All Sectors" Command="{Binding LowLevelViewModel.ReadAllSectorsCommand}"
                            IsEnabled="{Binding IsConnected}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Sector Results TabControl -->
        <TabControl Grid.Row="2" SelectedIndex="{Binding LowLevelViewModel.SelectedSectorTabIndex}"
                    ItemsSource="{Binding LowLevelViewModel.SectorResults}" Margin="0,0,0,10">
            <TabControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SectorReadResult">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock>
                            <TextBlock.Text>
                                <MultiBinding StringFormat="Sec {0}: {1}">
                                    <Binding Path="Sector"/>
                                    <Binding Path="Status"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </TabControl.ItemTemplate>
            <TabControl.DataTemplates>
                <DataTemplate DataType="vm:SectorReadResult" x:DataType="vm:SectorReadResult">
                    <ScrollViewer>
                        <StackPanel Margin="10" Spacing="8">
                            <TextBlock Text="{Binding Block0Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Block1Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Block2Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Block3Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </TabControl.DataTemplates>
        </TabControl>

        <TextBox Grid.Row="3" Text="{Binding LowLevelViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
    </Grid>
</UserControl>
