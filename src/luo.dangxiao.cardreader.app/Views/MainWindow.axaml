<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:luo.dangxiao.cardreader.app.ViewModels"
        xmlns:local="using:luo.dangxiao.cardreader.app.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="luo.dangxiao.cardreader.app.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="YCCARD Smart Card Reader Demo"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection Bar -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Device:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button Content="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"/>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1">
            <!-- Card ID Tab -->
            <TabItem Header="Card ID">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="Card ID Operations" FontSize="18" FontWeight="Bold"/>
                        
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Read Card ID" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Read Card ID" Command="{Binding CardIdViewModel.ReadCardIdCommand}"
                                            IsEnabled="{Binding IsConnected}" />
                                    <Button Content="Read Card ID (Retry)" Command="{Binding CardIdViewModel.ReadCardIdNewCommand}"
                                            IsEnabled="{Binding IsConnected}" />
                                    <Button Content="Beep" Command="{Binding CardIdViewModel.BeepCommand}"
                                            IsEnabled="{Binding IsConnected}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="Tag Type:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding CardIdViewModel.TagType, Mode=OneWay}" 
                                         IsReadOnly="True" Margin="0,5"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Serial Number:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CardIdViewModel.SerialNumber, Mode=OneWay, StringFormat=X8}" 
                                         IsReadOnly="True" Margin="0,5"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Result:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CardIdViewModel.ResultMessage, Mode=OneWay}" 
                                         IsReadOnly="True" Margin="0,5"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Query Card Tab -->
            <TabItem Header="Query Card">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="Query Card Type" FontSize="18" FontWeight="Bold"/>
                        
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10" Orientation="Horizontal">
                                <TextBlock Text="Wait Time (ms):" VerticalAlignment="Center"/>
                                <NumericUpDown Value="{Binding QueryCardViewModel.WaitTime}" Minimum="0" Maximum="10000" Width="140"/>
                                <Button Content="Query Card Type" Command="{Binding QueryCardViewModel.QueryCommand}"
                                        IsEnabled="{Binding IsConnected}" Width="130"/>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="System Type:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding QueryCardViewModel.SysType, Mode=OneWay}" IsReadOnly="True" Margin="0,5"/>
                                
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Card Type:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding QueryCardViewModel.CardType, Mode=OneWay}" IsReadOnly="True" Margin="0,5"/>
                                
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Card Serial:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding QueryCardViewModel.CardSerno, Mode=OneWay, StringFormat=X8}" IsReadOnly="True" Margin="0,5"/>
                                
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="OPT Number:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding QueryCardViewModel.OptNum, Mode=OneWay}" IsReadOnly="True" Margin="0,5"/>
                                
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Result:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding QueryCardViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True" Margin="0,5"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- POS Card Tab -->
            <TabItem Header="POS Card">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="POS (Payment) Card Operations" FontSize="18" FontWeight="Bold"/>
                        
                        <!-- Query Section -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Query POS User Card" FontWeight="SemiBold"/>
                                <Button Content="Query" Command="{Binding PosCardViewModel.QueryCommand}"
                                        IsEnabled="{Binding IsConnected}" Width="100" HorizontalAlignment="Left"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Serial No:"/>
                                        <TextBox Text="{Binding PosCardViewModel.QuerySerno, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Card No:"/>
                                        <TextBox Text="{Binding PosCardViewModel.QueryCardNo, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="User Type:"/>
                                        <TextBox Text="{Binding PosCardViewModel.QueryUserType, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Value:"/>
                                        <TextBox Text="{Binding PosCardViewModel.QueryValue, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Count:"/>
                                        <TextBox Text="{Binding PosCardViewModel.QueryCount, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Init Section -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Initialize POS User Card" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Serial No:"/>
                                        <NumericUpDown Value="{Binding PosCardViewModel.Serno}" Minimum="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Card No:"/>
                                        <TextBox Text="{Binding PosCardViewModel.CardNo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="User Type:"/>
                                        <NumericUpDown Value="{Binding PosCardViewModel.UserType}" Minimum="1" Maximum="32"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Initial Value:"/>
                                        <NumericUpDown Value="{Binding PosCardViewModel.Value}" Minimum="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Use Term:"/>
                                        <NumericUpDown Value="{Binding PosCardViewModel.UseTerm}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Init Card" Command="{Binding PosCardViewModel.InitCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Init with Balance" Command="{Binding PosCardViewModel.InitWithBalanceCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Write Section -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Write/Update Card" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Card Serial:"/>
                                        <TextBox Text="{Binding PosCardViewModel.CardSerno}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Value:"/>
                                        <NumericUpDown Value="{Binding PosCardViewModel.Value}" Minimum="0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Write Value" Command="{Binding PosCardViewModel.WriteValueCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Write + Count" Command="{Binding PosCardViewModel.WriteValueAddCountCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Reset Card" Command="{Binding PosCardViewModel.ResetCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- OPT Card Section -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Operator Card" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="OPT Number:" VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding PosCardViewModel.OptNum}" Minimum="0" Width="100"/>
                                    <Button Content="Init OPT Card" Command="{Binding PosCardViewModel.InitOptCardCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Reset OPT Card" Command="{Binding PosCardViewModel.ResetOptCardCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBox Text="{Binding PosCardViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- JS Card Tab -->
            <TabItem Header="JS Card">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="JS (Water Billing) Card Operations" FontSize="18" FontWeight="Bold"/>
                        
                        <!-- Query Section -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Query JS Card" FontWeight="SemiBold"/>
                                <Button Content="Query" Command="{Binding JsCardViewModel.QueryCommand}"
                                        IsEnabled="{Binding IsConnected}" Width="100" HorizontalAlignment="Left"/>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Serial No:"/>
                                        <TextBox Text="{Binding JsCardViewModel.QuerySerno, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Card No:"/>
                                        <TextBox Text="{Binding JsCardViewModel.QueryCardNo, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Balance:"/>
                                        <TextBox Text="{Binding JsCardViewModel.QueryValue, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Charge Times:"/>
                                        <TextBox Text="{Binding JsCardViewModel.QueryCount, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="User Type:"/>
                                        <TextBox Text="{Binding JsCardViewModel.QueryUserType, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Init Section -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Initialize JS User Card" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Serial No:"/>
                                        <NumericUpDown Value="{Binding JsCardViewModel.Serno}" Minimum="1"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Card No:"/>
                                        <TextBox Text="{Binding JsCardViewModel.CardNo}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="User Type:"/>
                                        <NumericUpDown Value="{Binding JsCardViewModel.UserType}" Minimum="1" Maximum="32"/>
                                    </StackPanel>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Initial Balance:"/>
                                        <NumericUpDown Value="{Binding JsCardViewModel.Balance}" Minimum="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Charge Times:"/>
                                        <NumericUpDown Value="{Binding JsCardViewModel.ChargeTimes}" Minimum="0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Init Card" Command="{Binding JsCardViewModel.InitCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Init with Balance" Command="{Binding JsCardViewModel.InitWithBalanceCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Write Section -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Write Balance" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Card Serial:"/>
                                        <TextBox Text="{Binding JsCardViewModel.CardSerno}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Balance:"/>
                                        <NumericUpDown Value="{Binding JsCardViewModel.Balance}" Minimum="0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Write Balance" Command="{Binding JsCardViewModel.WriteBalanceCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Write + Count" Command="{Binding JsCardViewModel.WriteBalanceAddCountCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Reset Card" Command="{Binding JsCardViewModel.ResetCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBox Text="{Binding JsCardViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Balance Tab -->
            <TabItem Header="Balance">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="Balance and Transfer Operations" FontSize="18" FontWeight="Bold"/>
                        
                        <!-- Read Balance -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Read Balance" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Card Serial:" VerticalAlignment="Center"/>
                                    <TextBox Text="{Binding BalanceViewModel.CardSerno}" Width="150"/>
                                    <Button Content="Read Balance" Command="{Binding BalanceViewModel.ReadBalanceCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Payment Balance:"/>
                                        <TextBox Text="{Binding BalanceViewModel.BalanceXf, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Water Billing Balance:"/>
                                        <TextBox Text="{Binding BalanceViewModel.BalanceJs, Mode=OneWay}" IsReadOnly="True"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Transfer -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Transfer Value" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Card Serial:"/>
                                        <TextBox Text="{Binding BalanceViewModel.CardSerno}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Transfer Value:"/>
                                        <NumericUpDown Value="{Binding BalanceViewModel.TransferValue}" Minimum="0"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="Flag:" VerticalAlignment="Center"/>
                                    <NumericUpDown Value="{Binding BalanceViewModel.TransferFlag}" Minimum="1" Maximum="2" Width="80"/>
                                    <TextBlock Text="(1=Payment, 2=Water)" VerticalAlignment="Center"/>
                                    <Button Content="Transfer" Command="{Binding BalanceViewModel.TransferCommand}"
                                            IsEnabled="{Binding IsConnected}" Margin="20,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBox Text="{Binding BalanceViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- User Type Tab -->
            <TabItem Header="User Type">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="User Type and Period Operations" FontSize="18" FontWeight="Bold"/>
                        
                        <!-- Change User Type -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Change User Type" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="New User Type:"/>
                                        <NumericUpDown Value="{Binding UserTypeViewModel.UserType}" Minimum="1" Maximum="32"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="System Type (1-3):"/>
                                        <NumericUpDown Value="{Binding UserTypeViewModel.SysType}" Minimum="1" Maximum="3"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Change Type" Command="{Binding UserTypeViewModel.ChangeUserTypeCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Change (with Old)" Command="{Binding UserTypeViewModel.ChangeUserTypeNewCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding UserTypeViewModel.OldUserType, StringFormat='Old Type: {0}'}"/>
                            </StackPanel>
                        </Border>

                        <!-- Update Period -->
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Update Validity Period" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Use Term:"/>
                                        <NumericUpDown Value="{Binding UserTypeViewModel.UseTerm}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Card Serial:"/>
                                        <TextBox Text="{Binding UserTypeViewModel.CardSerno}"/>
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Button Content="Update Period" Command="{Binding UserTypeViewModel.UpdatePeriodCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                    <Button Content="Write Term" Command="{Binding UserTypeViewModel.WriteTermCommand}"
                                            IsEnabled="{Binding IsConnected}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBox Text="{Binding UserTypeViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- License Tab -->
            <TabItem Header="License">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="License Configuration" FontSize="18" FontWeight="Bold"/>
                        
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="System Authorization" FontWeight="SemiBold"/>
                                <StackPanel Orientation="Horizontal" Spacing="20">
                                    <CheckBox Content="Payment System" IsChecked="{Binding LicenseViewModel.HasPaymentAuth}"/>
                                    <CheckBox Content="Water Billing System" IsChecked="{Binding LicenseViewModel.HasWaterBillingAuth}"/>
                                    <CheckBox Content="Access Control System" IsChecked="{Binding LicenseViewModel.HasAccessControlAuth}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Sector Configuration" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Spacing="5">
                                        <TextBlock Text="Payment Sector:"/>
                                        <NumericUpDown Value="{Binding LicenseViewModel.PaymentSector}" Minimum="1" Maximum="15" FormatString="N0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Water Billing Sector:"/>
                                        <NumericUpDown Value="{Binding LicenseViewModel.WaterBillingSector}" Minimum="1" Maximum="15" FormatString="N0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" Spacing="5">
                                        <TextBlock Text="Access Control Sector:"/>
                                        <NumericUpDown Value="{Binding LicenseViewModel.AccessControlSector}" Minimum="1" Maximum="15" FormatString="N0"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Operator Password" FontWeight="SemiBold"/>
                                <TextBox Text="{Binding LicenseViewModel.OperatorPassword}" />
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Keys from Licence" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="KeyA (Operator):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LicenseViewModel.UserKeyAHex, Mode=OneWay}" IsReadOnly="True" Margin="0,5" FontFamily="Consolas,Monospace"/>
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="KeyB (SystemKeyB):" VerticalAlignment="Center" Margin="20,5,10,5"/>
                                    <TextBox Grid.Row="0" Grid.Column="3" Text="{Binding LicenseViewModel.UserKeyBHex, Mode=OneWay}" IsReadOnly="True" Margin="0,5" FontFamily="Consolas,Monospace"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Load Licence File" FontWeight="SemiBold"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LicenseViewModel.LicenceFilePath}" Watermark="Select licencecard.dat file..."/>
                                    <Button Grid.Column="1" Content="Browse..." Command="{Binding LicenseViewModel.BrowseLicenceFileCommand}" Margin="10,0,0,0"/>
                                </Grid>
                                <Button Content="Load Licence" Command="{Binding LicenseViewModel.LoadLicenceCommand}" HorizontalAlignment="Left" Width="120"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Content="Apply Configuration" Command="{Binding LicenseViewModel.ConfigureCommand}"/>
                            <Button Content="Clear Authorization" Command="{Binding LicenseViewModel.ClearAuthCommand}"/>
                        </StackPanel>

                        <TextBox Text="{Binding LicenseViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Low Level Tab -->
            <TabItem Header="Low Level">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Sector Read/Write Section -->
                    <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                            BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Sector Read/Write (Blocks 0-3)" FontSize="16" FontWeight="Bold"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Spacing="5">
                                    <TextBlock Text="Sector (0-15):"/>
                                    <NumericUpDown Value="{Binding LowLevelViewModel.Sector}" Minimum="0" Maximum="15"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="5">
                                    <TextBlock Text="Key Mode (0=A, 4=B):"/>
                                    <NumericUpDown Value="{Binding LowLevelViewModel.KeyMode}" Minimum="0" Maximum="7"/>
                                </StackPanel>
                            </Grid>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Keys (hex, 6 bytes):"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0" Text="{Binding LowLevelViewModel.KeyAInput}" FontFamily="Consolas,Monospace" Margin="0,0,5,0"/>
                                    <TextBox Grid.Column="1" Text="{Binding LowLevelViewModel.KeyBInput}" FontFamily="Consolas,Monospace" Margin="5,0,0,0"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6">KeyA:</TextBlock>
                                    <TextBlock Text="{Binding LowLevelViewModel.KeyAInput}" VerticalAlignment="Center" FontFamily="Consolas,Monospace" FontSize="11"/>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" Opacity="0.6" Margin="10,0,0,0">KeyB:</TextBlock>
                                    <TextBlock Text="{Binding LowLevelViewModel.KeyBInput}" VerticalAlignment="Center" FontFamily="Consolas,Monospace" FontSize="11"/>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="5">
                                <TextBlock Text="Block Data (hex, 16 bytes each):"/>
                                <Grid RowDefinitions="Auto,4,Auto,4,Auto,4,Auto" ColumnDefinitions="Auto,*">
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="B0:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding LowLevelViewModel.Block0Data}" FontFamily="Consolas,Monospace"/>
                                    <Separator Grid.Row="1" Grid.Column="1"/>
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="B1:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                                    <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding LowLevelViewModel.Block1Data}" FontFamily="Consolas,Monospace"/>
                                    <Separator Grid.Row="3" Grid.Column="1"/>
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="B2:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                                    <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding LowLevelViewModel.Block2Data}" FontFamily="Consolas,Monospace"/>
                                    <Separator Grid.Row="5" Grid.Column="1"/>
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="B3:" VerticalAlignment="Center" Margin="0,0,8,0" FontFamily="Consolas,Monospace" FontWeight="Bold"/>
                                    <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding LowLevelViewModel.Block3Data}" FontFamily="Consolas,Monospace"/>
                                </Grid>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Read Sector" Command="{Binding LowLevelViewModel.ReadBlockCommand}"
                                        IsEnabled="{Binding IsConnected}"/>
                                <Button Content="Write Sector" Command="{Binding LowLevelViewModel.WriteBlockCommand}"
                                        IsEnabled="{Binding IsConnected}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Read All Sectors Section -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                            BorderThickness="1" Padding="15" CornerRadius="5" Margin="0,0,0,10">
                        <StackPanel Spacing="10">
                            <TextBlock Text="Read All Sectors (0-15)" FontSize="16" FontWeight="Bold"/>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button Content="Read All Sectors" Command="{Binding LowLevelViewModel.ReadAllSectorsCommand}"
                                        IsEnabled="{Binding IsConnected}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Sector Results TabControl -->
                    <TabControl Grid.Row="2" SelectedIndex="{Binding LowLevelViewModel.SelectedSectorTabIndex}"
                                ItemsSource="{Binding LowLevelViewModel.SectorResults}" Margin="0,0,0,10">
                        <TabControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <MultiBinding StringFormat="Sec {0}: {1}">
                                                <Binding Path="Sector"/>
                                                <Binding Path="Status"/>
                                            </MultiBinding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </TabControl.ItemTemplate>
                        <TabControl.DataTemplates>
                            <DataTemplate DataType="local:SectorReadResult">
                                <ScrollViewer>
                                    <StackPanel Margin="10" Spacing="8">
                                        <TextBlock Text="{Binding Block0Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Block1Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Block2Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding Block3Result}" FontFamily="Consolas,Monospace" FontSize="12" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </DataTemplate>
                        </TabControl.DataTemplates>
                    </TabControl>

                    <TextBox Grid.Row="3" Text="{Binding LowLevelViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
                </Grid>
            </TabItem>

            <!-- Sys Card Tab -->
            <TabItem Header="Sys Card">
                <ScrollViewer>
                    <StackPanel Margin="20" Spacing="15">
                        <TextBlock Text="System Card Initialization" FontSize="18" FontWeight="Bold"/>
                        
                        <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                                BorderThickness="1" Padding="15" CornerRadius="5">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Initialize System Card" FontWeight="SemiBold"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    
                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="User Password:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                    <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SysCardViewModel.UserPassword}" Watermark="8 characters"/>
                                    
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="System Type:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                    <ComboBox Grid.Row="1" Grid.Column="1" 
                                              SelectedIndex="{Binding SysCardViewModel.SystemTypeIndex}"
                                              HorizontalAlignment="Left" Width="200">
                                        <ComboBoxItem Content="Payment System (MJXT)"/>
                                        <ComboBoxItem Content="Water Billing (SFXT)"/>
                                        <ComboBoxItem Content="Access Control (JSXT)"/>
                                    </ComboBox>
                                    
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Use Sector (1-31):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                    <NumericUpDown Grid.Row="2" Grid.Column="1" 
                                                   Value="{Binding SysCardViewModel.UseSector}" 
                                                   Minimum="1" Maximum="31" Width="100" HorizontalAlignment="Left"/>
                                    
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Comm Password:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                                    <TextBox Grid.Row="3" Grid.Column="1" 
                                             Text="{Binding SysCardViewModel.CommPassword, Mode=OneWay}" 
                                             IsReadOnly="True" FontFamily="Consolas"/>
                                </Grid>
                                
                                <Button Content="Initialize System Card" 
                                        Command="{Binding SysCardViewModel.InitSysCardCommand}"
                                        IsEnabled="{Binding IsConnected}" Width="180" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBox Text="{Binding SysCardViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Debug Log Tab -->
            <TabItem Header="Debug Log">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Communication Debug Log" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                            BorderThickness="1" Padding="5" CornerRadius="5">
                        <ScrollViewer>
                            <TextBox Text="{Binding LogMessage, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     AcceptsReturn="True"
                                     FontFamily="Consolas,Monospace"
                                     FontSize="12"/>
                        </ScrollViewer>
                    </Border>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Clear Log" Command="{Binding ClearLogCommand}"/>
                        <TextBlock Text="{Binding LogEntryCount, StringFormat='Entries: {0}'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1" Padding="5" CornerRadius="3" Margin="0,10,0,0">
            <TextBlock Text="YCCARD Smart Card Reader Library Demo - Cross-platform .NET 10"/>
        </Border>
    </Grid>
</Window>