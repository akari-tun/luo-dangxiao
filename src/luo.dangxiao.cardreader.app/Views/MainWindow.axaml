<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:luo.dangxiao.cardreader.app.ViewModels"
        xmlns:views="using:luo.dangxiao.cardreader.app.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
        x:Class="luo.dangxiao.cardreader.app.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="YCCARD Smart Card Reader Demo"
        Width="1000" Height="700"
        MinWidth="800" MinHeight="600">

    <Design.DataContext>
        <vm:MainViewModel/>
    </Design.DataContext>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Connection Bar -->
        <Border Grid.Row="0" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1" Padding="10" CornerRadius="5" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Device:" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center" FontWeight="Bold"/>
                <Button Content="Connect" Command="{Binding ConnectCommand}" IsVisible="{Binding !IsConnected}"/>
                <Button Content="Disconnect" Command="{Binding DisconnectCommand}" IsVisible="{Binding IsConnected}"/>
            </StackPanel>
        </Border>

        <!-- Tab Control -->
        <TabControl Grid.Row="1">
            <!-- Card ID Tab -->
            <TabItem Header="Card ID">
                <views:CardIdView/>
            </TabItem>

            <!-- Query Card Tab -->
            <TabItem Header="Query Card">
                <views:QueryCardView/>
            </TabItem>

            <!-- POS Card Tab -->
            <TabItem Header="POS Card">
                <views:PosCardView/>
            </TabItem>

            <!-- JS Card Tab -->
            <TabItem Header="JS Card">
                <views:JsCardView/>
            </TabItem>

            <!-- Balance Tab -->
            <TabItem Header="Balance">
                <views:BalanceView/>
            </TabItem>

            <!-- User Type Tab -->
            <TabItem Header="User Type">
                <views:UserTypeView/>
            </TabItem>

            <!-- License Tab -->
            <TabItem Header="License">
                <views:LicenseView/>
            </TabItem>

            <!-- Low Level Tab -->
            <TabItem Header="Low Level">
                <views:LowLevelView/>
            </TabItem>

            <!-- Sys Card Tab -->
            <TabItem Header="Sys Card">
                <views:SysCardView/>
            </TabItem>

            <!-- Debug Log Tab -->
            <TabItem Header="Debug Log">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="Communication Debug Log" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
                    
                    <Border Grid.Row="1" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                            BorderThickness="1" Padding="5" CornerRadius="5">
                        <ScrollViewer>
                            <TextBox Text="{Binding LogMessage, Mode=OneWay}" 
                                     IsReadOnly="True" 
                                     AcceptsReturn="True"
                                     FontFamily="Consolas,Monospace"
                                     FontSize="12"/>
                        </ScrollViewer>
                    </Border>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                        <Button Content="Clear Log" Command="{Binding ClearLogCommand}"/>
                        <TextBlock Text="{Binding LogEntryCount, StringFormat='Entries: {0}'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                BorderThickness="1" Padding="5" CornerRadius="3" Margin="0,10,0,0">
            <TextBlock Text="YCCARD Smart Card Reader Library Demo - Cross-platform .NET 10"/>
        </Border>
    </Grid>
</Window>
