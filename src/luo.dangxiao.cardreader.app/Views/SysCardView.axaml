<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:luo.dangxiao.cardreader.app.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="luo.dangxiao.cardreader.app.Views.SysCardView"
             x:DataType="vm:MainViewModel">
    <ScrollViewer>
        <StackPanel Margin="20" Spacing="15">
            <TextBlock Text="System Card Initialization" FontSize="18" FontWeight="Bold"/>
            
            <Border BorderBrush="{DynamicResource SystemControlForegroundBaseMediumBrush}" 
                    BorderThickness="1" Padding="15" CornerRadius="5">
                <StackPanel Spacing="10">
                    <TextBlock Text="Initialize System Card" FontWeight="SemiBold"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="User Password:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SysCardViewModel.UserPassword}" Watermark="8 characters"/>
                        
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="System Type:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <ComboBox Grid.Row="1" Grid.Column="1" 
                                  SelectedIndex="{Binding SysCardViewModel.SystemTypeIndex}"
                                  HorizontalAlignment="Left" Width="200">
                            <ComboBoxItem Content="Payment System (MJXT)"/>
                            <ComboBoxItem Content="Water Billing (SFXT)"/>
                            <ComboBoxItem Content="Access Control (JSXT)"/>
                        </ComboBox>
                        
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Use Sector (1-31):" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <NumericUpDown Grid.Row="2" Grid.Column="1" 
                                       Value="{Binding SysCardViewModel.UseSector}" 
                                       Minimum="1" Maximum="31" Width="100" HorizontalAlignment="Left"/>
                        
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Comm Password:" VerticalAlignment="Center" Margin="0,5,10,5"/>
                        <TextBox Grid.Row="3" Grid.Column="1" 
                                 Text="{Binding SysCardViewModel.CommPassword, Mode=OneWay}" 
                                 IsReadOnly="True" FontFamily="Consolas"/>
                    </Grid>
                    
                    <Button Content="Initialize System Card" 
                            Command="{Binding SysCardViewModel.InitSysCardCommand}"
                            IsEnabled="{Binding IsConnected}" Width="180" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                </StackPanel>
            </Border>

            <TextBox Text="{Binding SysCardViewModel.ResultMessage, Mode=OneWay}" IsReadOnly="True"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
