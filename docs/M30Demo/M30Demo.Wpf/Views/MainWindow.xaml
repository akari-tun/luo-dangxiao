<Window x:Class="M30Demo.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="M30Demo - Card Operations" Width="850" Height="620"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <TextBlock Text="M30Demo YCCard Card Operations"
                   FontSize="16" FontWeight="Bold" Margin="0,0,0,5"/>

        <TabControl Grid.Row="1" x:Name="tabOperations" Margin="0,5">
            <TabItem Header="Read Card ID">
                <TextBlock Margin="10" Text="Reads the physical card ID (factory fixed). No parameters required."/>
            </TabItem>

            <TabItem Header="Read Card">
                <TextBlock Margin="10" Text="Reads full card data including consume balance, water balance, user info. No parameters required."/>
            </TabItem>

            <TabItem Header="Init Card">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="10">
                    <WrapPanel Orientation="Vertical" MaxWidth="700">
                        <TextBlock Text="Initialize / issue a new card" FontWeight="Bold" FontSize="14" Margin="0,0,0,8"/>

                        <TextBlock Text="Card ID (Serial No):" Margin="0,4,0,2"/>
                        <TextBox x:Name="txtCardID" Text="10001" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="Employee ID (EmpStrID):" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtEmpID" Text="U001" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="Employee Name:" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtEmpName" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="Card Type Name:" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtCardTypeName" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="Card Type ID (1-32):" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtCardTypeID" Text="1" Width="100" HorizontalAlignment="Left"/>

                        <TextBlock Text="Use Term (yymmdd, e.g. 271231):" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtUseTerm" Text="271231" Width="200" HorizontalAlignment="Left"/>

                        <TextBlock Text="Consume Value (元):" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtXCardValue" Text="100" Width="100" HorizontalAlignment="Left"/>

                        <TextBlock Text="Water Value (元):" Margin="0,8,0,2"/>
                        <TextBox x:Name="txtWCardValue" Text="50" Width="100" HorizontalAlignment="Left"/>

                        <CheckBox x:Name="chkCredit" Content="Credit Value (recharge after init)"
                                  IsChecked="True" Margin="0,12,0,4"/>

                        <TextBlock Text="Issue Type: 0=Both, 1=Consume Only, 2=Water Only:" Margin="0,4,0,2"/>
                        <ComboBox x:Name="cmbIssueType" Width="100" HorizontalAlignment="Left" SelectedIndex="0">
                            <ComboBoxItem Content="0 - Both"/>
                            <ComboBoxItem Content="1 - Consume Only"/>
                            <ComboBoxItem Content="2 - Water Only"/>
                        </ComboBox>
                    </WrapPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Recycle Card">
                <StackPanel Margin="10">
                    <TextBlock Text="Recycle (reset) a card, clearing all data"/>
                    <TextBlock Text="Card Serno (leave blank to auto-detect):" Margin="0,10,0,4"/>
                    <TextBox x:Name="txtCardSerno" Width="200" HorizontalAlignment="Left"/>
                </StackPanel>
            </TabItem>
        </TabControl>

        <GroupBox Grid.Row="2" Header="JSON Output" Margin="0,8,0,0">
            <DockPanel Margin="4">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Top" Margin="0,0,0,5">
                    <Button x:Name="btnExecute" Content="  Execute  " Padding="20,5" Click="BtnExecute_Click"
                            HorizontalAlignment="Left"/>
                    <Button Content="  Clear  " Padding="20,5" Click="BtnClear_Click"
                            Margin="10,0,0,0" HorizontalAlignment="Left"/>
                    <TextBlock x:Name="txtStatus" Text="Ready"
                               Margin="20,4,0,0" VerticalAlignment="Center" Foreground="Gray"/>
                </StackPanel>
                <TextBox x:Name="txtOutput" IsReadOnly="True" TextWrapping="NoWrap"
                         FontFamily="Consolas, 'Courier New', monospace" FontSize="11"
                         Background="#f5f5f5" BorderThickness="0"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"/>
            </DockPanel>
        </GroupBox>
    </Grid>
</Window>
