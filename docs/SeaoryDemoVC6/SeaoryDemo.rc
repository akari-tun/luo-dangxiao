    DEFPUSHBUTTON   "OK",IDOK,178,7,50,14,WS_GROUP
    LTEXT           "Shenzhen Seaory Technology CO.,LTD.",IDC_STATIC,40,52,
                    168,8
END

IDD_SEAORYDEMO_DIALOG DIALOGEX 0, 0, 480, 370
STYLE DS_MODALFRAME | WS_MINIMIZEBOX | WS_POPUP | WS_VISIBLE | WS_CAPTION | 
    WS_SYSMENU
